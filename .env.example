# Find your Replicate API token at https://www.replicate.com/account
API_HOST=
# S3 (圖生影片上傳用) - 請填在 .env.local, 不要提交到 git
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
# PostgreSQL (後台模板管理)
# docker-compose 內建的 postgres 服務: 帳號密碼在第一次啟動時建立
POSTGRES_USER=txt2img
POSTGRES_PASSWORD=
POSTGRES_DB=txt2img
# 用 docker-compose 時主機填 postgres; 本機開發填 localhost; 雲端資料庫可加 ?sslmode=require
DATABASE_URL=postgres://txt2img:password@postgres:5432/txt2img
# 後台 /admin 登入密碼; ADMIN_SECRET 可選, 用來簽 session cookie
ADMIN_PASSWORD=
ADMIN_SECRET=
